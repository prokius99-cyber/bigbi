---
/**
 * visit — финал страницы, шахматка. Якорь #visit (кнопка hero «Как найти корнер 14»).
 * Данные только из business (src/data/site.ts). Карты нет: координат нет — только маршрут по ссылке.
 * Текст — только на плашках (.post, .tag, лента); шахматка за ними.
 */
import { Image } from 'astro:assets';
import Section from '../components/Section.astro';
import Ribbon from '../components/Ribbon.astro';
import MapCard from '../components/MapCard.astro';
import hands from '../assets/cutouts/hands.png';
import { business as b } from '../data/site';

const tg = b.links.telegram ? `https://t.me/${b.links.telegram}` : '';
const stores = [
  tg && { href: tg, label: 'Telegram' },
  b.links.appStore && { href: b.links.appStore, label: 'App Store' },
  b.links.googlePlay && { href: b.links.googlePlay, label: 'Google Play' },
].filter(Boolean) as { href: string; label: string }[];
---
<Section id="visit" title="Корнер 14, 3 этаж" class="visit">
  <div class="checker" aria-hidden="true"></div>
  <Ribbon class="visit-ribbon" items={['Корнер 14', 'ТРЦ «Меркурий»', '3 этаж']} tone="ink" tilt={-1} />

  <div class="visit-stage">
    <div class="visit-post post">
      <div class="visit-info">
        <MapCard title="" actions={false} />
      </div>

      {b.metro.length > 0 && (
        <ul class="visit-metro">
          {b.metro.map((m) => <li><span>Метро</span> «{m.name}», {m.distance}</li>)}
        </ul>
      )}

      <a class="visit-phone" href={`tel:${b.phone.e164}`}>{b.phone.display}</a>

      <div class="visit-actions">
        {b.links.twoGis && (
          <a class="btn" href={b.links.twoGis} target="_blank" rel="noopener">
            Маршрут в 2ГИС
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 11h12.2l-5.1-5.1L12.5 4.5 20 12l-7.5 7.5-1.4-1.4 5.1-5.1H4z"/></svg>
          </a>
        )}
        <a class="btn btn-green" href={`tel:${b.phone.e164}`}>Позвонить</a>
      </div>

      {stores.length > 0 && (
        <ul class="visit-links">
          {stores.map((l) => (
            <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>
          ))}
        </ul>
      )}
    </div>

    <div class="visit-cut">
      <div class="bob">
        <Image class="die" src={hands} width={237} format="webp" alt="Сэндвич в руках в перчатках" loading="lazy" />
      </div>
      <span class="tag t-sauce tilt-4 visit-tag"><b class="nw">Из-под ножа</b></span>
    </div>
  </div>
</Section>

<style>
  .nw { white-space: nowrap; }
  :global(.visit) { position: relative; overflow: clip; isolation: isolate; padding-top: calc(var(--s-16) + var(--t-ribbon) * 2); }

  :global(.visit .visit-ribbon) { position: absolute; top: var(--s-8); left: 0; right: 0; margin: 0; z-index: var(--z-ribbon); }

  /* заголовок — на своей плашке, не на шахматке */
  :global(.visit .section-title) {
    position: relative; z-index: var(--z-post);
    display: inline-block; max-width: 100%;
    padding: var(--s-3) var(--s-6);
    background: var(--c-secondary); color: var(--c-on-secondary-lg);
    border: calc(var(--die-w) + 1px) solid var(--c-die); border-radius: var(--r-md);
    box-shadow: var(--shadow-sticker);
    font: 400 var(--t-h2)/var(--t-h2-lh) var(--f-display);
    letter-spacing: var(--t-h2-ls);
    text-transform: uppercase;
    rotate: var(--tilt-2);
    margin-bottom: var(--s-8);
    overflow-wrap: anywhere;
  }

  .visit-stage { position: relative; display: grid; gap: var(--s-12); }
  .visit-post {
    z-index: var(--z-post);
    padding: var(--s-6);
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-6);
  }

  .visit-info :global(.mc-addr) { font-size: var(--t-lead); font-weight: 800; line-height: 1.3; }
  .visit-info :global(.mc-note) { color: var(--c-text); font-size: var(--t-lead); font-weight: 800; line-height: 1.3; }
  .visit-info :global(.mc-hours) {
    display: inline-block; margin-top: var(--s-4); padding: var(--s-2) var(--s-4);
    background: var(--c-secondary); color: var(--c-on-secondary);
    border-radius: var(--r-sm); font-size: var(--t-body); font-weight: 800;
  }

  .visit-metro { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-1); font-size: var(--t-body); line-height: 1.4; }
  .visit-metro span { color: var(--c-muted); }

  .visit-phone {
    display: inline-flex; align-items: center; min-height: var(--tap);
    font: 400 var(--t-h3)/1.15 var(--f-display); color: var(--c-text);
    text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px;
    text-decoration-color: var(--c-accent);
  }

  .visit-actions { display: flex; flex-wrap: wrap; gap: var(--s-4); width: 100%; }
  .visit-actions .btn { flex: 1 1 14rem; padding-inline: var(--s-6); }

  .visit-links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .visit-links a {
    display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 var(--s-6);
    background: var(--c-surface); color: var(--c-accent-text);
    border: var(--die-w) solid var(--c-text); border-radius: var(--r-pill);
    font: 800 var(--t-body)/1 var(--f-body); text-decoration: none;
    transition: transform var(--d-micro) var(--e-out);
  }
  .visit-links a:hover { transform: translateY(-2px); }
  .visit-links a:active { transform: translateY(2px); }

  .visit a:focus-visible { outline: 3px solid var(--c-text); outline-offset: 3px; box-shadow: 0 0 0 6px var(--c-die); }

  .visit-cut { position: relative; z-index: var(--z-sticker); justify-self: center; width: min(240px, 70%); }
  .visit-cut :global(img) { display: block; width: 100%; height: auto; }
  .visit-tag { position: absolute; left: -12%; bottom: -8%; white-space: nowrap; }
  .visit-tag :global(b) { font-size: var(--t-h3); }

  @media (min-width: 768px) {
    .visit-post { padding: var(--s-8); }
  }
  @media (min-width: 1024px) {
    .visit-stage { grid-template-columns: minmax(0, 44rem) 1fr; align-items: center; gap: var(--s-16); }
    .visit-cut { justify-self: start; width: 240px; }
    .visit-tag { left: -30px; }
  }
</style>
